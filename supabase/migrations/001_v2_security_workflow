-- =====================================================================
-- D&A Tools  -  v2 migration: security (RLS), workflow rules, history
-- Run ONCE in: Supabase Dashboard -> SQL Editor -> New query -> Run.
-- It is safe to re-run (idempotent).
--
-- WARNING: section 6 DROPS every existing RLS policy on profiles,
-- coworkers, requests and request_status_history and recreates them.
-- This is intentional so no old, too-permissive policy stays active.
-- =====================================================================

-- ---------------------------------------------------------------------
-- 1. New columns
-- ---------------------------------------------------------------------
alter table public.profiles add column if not exists is_active boolean not null default true;
alter table public.requests add column if not exists supplier_url text;
alter table public.requests add column if not exists rejection_reason text;

-- Data sanity checks (NOT VALID = do not fail on old rows, enforce on new ones)
do $$ begin
  if not exists (select 1 from pg_constraint where conname = 'requests_quantity_positive') then
    alter table public.requests add constraint requests_quantity_positive check (quantity > 0) not valid;
  end if;
  if not exists (select 1 from pg_constraint where conname = 'requests_price_not_negative') then
    alter table public.requests add constraint requests_price_not_negative check (unit_price is null or unit_price >= 0) not valid;
  end if;
end $$;

-- ---------------------------------------------------------------------
-- 2. Helper functions
-- ---------------------------------------------------------------------
create or replace function public.is_admin()
returns boolean language sql stable security definer set search_path = public as $$
  select exists (
    select 1 from public.profiles
    where id = auth.uid() and role::text = 'admin' and is_active
  );
$$;

create or replace function public.is_active_user()
returns boolean language sql stable security definer set search_path = public as $$
  select exists (select 1 from public.profiles where id = auth.uid() and is_active);
$$;

-- ---------------------------------------------------------------------
-- 3. Auto-create a profile when a user is added in Supabase Auth
--    (default role = team_leader; promote to admin from the Users page)
-- ---------------------------------------------------------------------
create or replace function public.handle_new_user()
returns trigger language plpgsql security definer set search_path = public as $$
begin
  insert into public.profiles (id, email, full_name, role)
  values (
    new.id,
    new.email,
    coalesce(new.raw_user_meta_data->>'full_name', split_part(new.email, '@', 1)),
    'team_leader'
  )
  on conflict (id) do nothing;
  return new;
end $$;

drop trigger if exists on_auth_user_created on auth.users;
create trigger on_auth_user_created
  after insert on auth.users
  for each row execute function public.handle_new_user();

-- ---------------------------------------------------------------------
-- 4. Status history table
-- ---------------------------------------------------------------------
create table if not exists public.request_status_history (
  id          uuid primary key default gen_random_uuid(),
  request_id  uuid not null references public.requests(id) on delete cascade,
  from_status text,
  to_status   text not null,
  reason      text,
  changed_by  uuid references public.profiles(id) on delete set null,
  changed_at  timestamptz not null default now()
);
create index if not exists request_status_history_request_idx
  on public.request_status_history (request_id, changed_at);

-- Backfill: one "created" entry for every existing request without history
insert into public.request_status_history (request_id, from_status, to_status, changed_at)
select r.id, null, r.status::text, r.created_at
from public.requests r
where not exists (select 1 from public.request_status_history h where h.request_id = r.id);

-- ---------------------------------------------------------------------
-- 5. Workflow rules (trigger) + history logging (trigger)
-- ---------------------------------------------------------------------
create or replace function public.guard_request_update()
returns trigger language plpgsql security definer set search_path = public as $$
declare
  is_adm  boolean := public.is_admin();
  allowed text[];
begin
  new.updated_at   := now();
  new.id           := old.id;
  new.requested_by := old.requested_by;
  new.request_date := old.request_date;

  -- auth.uid() is null for the SQL editor / service role: let those through.
  if auth.uid() is not null and not is_adm then
    if old.status::text <> 'Submitted' then
      raise exception 'Only an admin can change a request once it is past Submitted';
    end if;
    if new.status::text not in ('Submitted', 'Cancelled') then
      raise exception 'You can only edit or cancel a Submitted request';
    end if;
    new.handover_date    := old.handover_date;
    new.rejection_reason := old.rejection_reason;
  end if;

  if new.status::text is distinct from old.status::text then
    allowed := case old.status::text
      when 'Submitted'    then array['Under Review','Rejected','Cancelled']
      when 'Under Review' then array['Submitted','Ordered','Rejected','Cancelled']
      when 'Ordered'      then array['Under Review','Received','Cancelled']
      when 'Received'     then array['Ordered','Delivered']
      when 'Delivered'    then array['Received','Closed']
      else array[]::text[]
    end;

    if not (new.status::text = any(allowed)) then
      raise exception 'Invalid status change: % -> %', old.status, new.status;
    end if;

    if new.status::text = 'Rejected' and coalesce(btrim(new.rejection_reason), '') = '' then
      raise exception 'A reason is required when rejecting a request';
    end if;

    if new.status::text = 'Delivered' and new.handover_date is null then
      new.handover_date := current_date;
    end if;

    if new.status::text in ('Submitted','Under Review','Ordered','Received') then
      new.handover_date := null;
    end if;
  end if;

  return new;
end $$;

drop trigger if exists trg_guard_request_update on public.requests;
create trigger trg_guard_request_update
  before update on public.requests
  for each row execute function public.guard_request_update();

create or replace function public.log_request_status()
returns trigger language plpgsql security definer set search_path = public as $$
begin
  if tg_op = 'INSERT' then
    insert into public.request_status_history (request_id, from_status, to_status, changed_by)
    values (new.id, null, new.status::text, auth.uid());
  elsif new.status::text is distinct from old.status::text then
    insert into public.request_status_history (request_id, from_status, to_status, reason, changed_by)
    values (
      new.id, old.status::text, new.status::text,
      case when new.status::text = 'Rejected' then new.rejection_reason end,
      auth.uid()
    );
  end if;
  return null;
end $$;

drop trigger if exists trg_log_request_status on public.requests;
create trigger trg_log_request_status
  after insert or update on public.requests
  for each row execute function public.log_request_status();

-- ---------------------------------------------------------------------
-- 6. Row Level Security
-- ---------------------------------------------------------------------
do $$
declare p record;
begin
  for p in
    select policyname, tablename from pg_policies
    where schemaname = 'public'
      and tablename in ('profiles','coworkers','requests','request_status_history')
  loop
    execute format('drop policy %I on public.%I', p.policyname, p.tablename);
  end loop;
end $$;

alter table public.profiles                enable row level security;
alter table public.coworkers               enable row level security;
alter table public.requests                enable row level security;
alter table public.request_status_history  enable row level security;

grant select on public.request_status_history to authenticated;

-- profiles: everyone signed in can read; only admins can change (role, active, name)
create policy profiles_select on public.profiles
  for select to authenticated using (true);
create policy profiles_update_admin on public.profiles
  for update to authenticated using (public.is_admin()) with check (public.is_admin());

-- coworkers: active users read; admins write
create policy coworkers_select on public.coworkers
  for select to authenticated using (public.is_active_user());
create policy coworkers_insert_admin on public.coworkers
  for insert to authenticated with check (public.is_admin());
create policy coworkers_update_admin on public.coworkers
  for update to authenticated using (public.is_admin()) with check (public.is_admin());
create policy coworkers_delete_admin on public.coworkers
  for delete to authenticated using (public.is_admin());

-- requests
create policy requests_select on public.requests
  for select to authenticated using (public.is_active_user());
create policy requests_insert on public.requests
  for insert to authenticated
  with check (
    public.is_active_user()
    and requested_by = auth.uid()
    and status::text = 'Submitted'
  );
create policy requests_update on public.requests
  for update to authenticated
  using (public.is_admin() or (requested_by = auth.uid() and status::text = 'Submitted'))
  with check (public.is_admin() or requested_by = auth.uid());
create policy requests_delete_admin on public.requests
  for delete to authenticated using (public.is_admin());

-- history: read-only for clients (rows are written by the trigger above)
create policy history_select on public.request_status_history
  for select to authenticated using (public.is_active_user());

-- ---------------------------------------------------------------------
-- 7. Realtime on requests
-- ---------------------------------------------------------------------
do $$ begin
  alter publication supabase_realtime add table public.requests;
exception when duplicate_object then null;
end $$;
